# Copy to .env.mac. Never commit the actual file.
# Generate one shared token: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
NODE_API_TOKEN=replace-with-a-random-token
POSTGRES_PASSWORD=replace-with-a-different-random-password
DATABASE_URL=postgresql+psycopg://rag:replace-with-a-different-random-password@127.0.0.1:5432/rag
# First local rehearsal: RAG is localhost. Later use the Azure Tailscale IP.
RAG_URL=http://127.0.0.1:8001
INFERENCE_URL=http://127.0.0.1:8002
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:1.7b
EMBED_MODEL=embeddinggemma
QDRANT_URL=http://127.0.0.1:6333
# Set to the Mac's Tailscale IPv4 before enabling Azure access.
MAC_INFERENCE_BIND=127.0.0.1
WORKER_CONCURRENCY=2
LEASE_SECONDS=60
MAX_ATTEMPTS=3
CACHE_TTL_SECONDS=3600
# Mac with 8 GB: keep one model operation at a time and unload after each call.
INFERENCE_PARALLEL=1
MODEL_KEEP_ALIVE=0s
