# Copy to .env.azure on the VM, with the SAME NODE_API_TOKEN as on the Mac.
NODE_API_TOKEN=replace-with-the-same-token-as-on-mac
INFERENCE_URL=http://MAC_TAILSCALE_IP:8002
EMBED_MODEL=embeddinggemma
QDRANT_URL=http://qdrant:6333
# Replace with the VM's Tailscale IPv4; never expose this API to the public internet.
AZURE_BIND_IP=127.0.0.1
