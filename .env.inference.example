# Copy to .env.inference on the GPU notebook. Same shared token as on app + RAG nodes.
NODE_API_TOKEN=replace-with-the-same-token-as-on-mac
INFERENCE_BIND=127.0.0.1
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
EMBED_MODEL=embeddinggemma
INFERENCE_PARALLEL=1
LLM_CONTEXT_SIZE=4096
LLM_MAX_TOKENS=512
MODEL_KEEP_ALIVE=5m
